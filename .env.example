# --- Telegram -------------------------------------------------------------
# From @BotFather: /newbot, then copy the token here.
BOT_TOKEN=123456:ABC-DEF_your_bot_token_here

# The bot's @username, without the @. Used to build referral links.
BOT_USERNAME=vigo_miner_bot

# The Mini App short name you set with /newapp in @BotFather.
WEB_APP_SHORT_NAME=app

# Public HTTPS URL that serves public/index.html. Telegram will not load a
# Mini App over plain http, so use a tunnel (ngrok, cloudflared) while developing.
WEB_APP_URL=https://your-domain.example/

# --- Server ---------------------------------------------------------------
PORT=3000
DB_PATH=./data/vigo.db

# Signs the session tokens the mini app carries. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# How old Telegram initData may be, in seconds (default 24h).
INIT_DATA_MAX_AGE=86400

# Set to 1 ONLY for local development: allows /?dev=123 login with no
# Telegram signature at all. Never enable this on a public deployment.
ALLOW_DEV_AUTH=0
