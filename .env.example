# ---------------------------------------------------------------- Server ----
PORT=3000
NODE_ENV=development
DB_PATH=./data/vigo-match.db

# Nơi lưu ảnh người dùng tải lên. Khi chạy nhiều máy chủ, trỏ vào ổ đĩa dùng chung.
UPLOAD_DIR=./uploads

# Ký session token và các token ngắn hạn khác.
# Sinh một chuỗi mới: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-please-32-bytes-minimum
SESSION_TTL_DAYS=30

# Khoá mã hoá dữ liệu nhạy cảm (số CCCD, ảnh giấy tờ). BẮT BUỘC đổi khi chạy thật.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PII_ENCRYPTION_KEY=

# ------------------------------------------------------------------ SMS ----
# console = in mã ra terminal (chỉ dùng khi phát triển)
# twilio  = dịch vụ quốc tế
# esms    = eSMS.vn, phổ biến cho tin OTP tại Việt Nam
# http    = gọi webhook của bạn, để nối nhà cung cấp khác mà không sửa code
SMS_PROVIDER=console

# Tên hiển thị ở đầu nội dung tin.
SMS_SENDER_NAME=Vigo Match

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+15550001111

# --- eSMS.vn ---
# Brandname phải được eSMS duyệt trước khi dùng.
# SmsType: 2 = tin CSKH qua brandname, 8 = tin từ số cố định.
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_BRANDNAME=
ESMS_SMS_TYPE=2

# --- Webhook tự dựng ---
# Nhận POST JSON: { to, text, purpose }. Trả về { id } để lưu làm mã tham chiếu.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# ------------------------------------------------------------------ OTP ----
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Khi bật, API trả về mã OTP ngay trong response để tiện phát triển và chạy test.
# Biến này bị vô hiệu hoá hoàn toàn khi NODE_ENV=production, nên dù có sót lại
# trong tệp .env thì môi trường thật cũng không bao giờ lộ mã.
EXPOSE_OTP=1

# ------------------------------------------------------------- Matching ----
# Bán kính tối đa (km) người dùng free có thể tìm.
MAX_RADIUS_FREE_KM=50
MAX_RADIUS_PREMIUM_KM=200
DAILY_PICKS_COUNT=8
FREE_DAILY_LIKES=40

# ------------------------------------------------------------------ AI ------
# Tuỳ chọn. Khi có key, AI Matchmaker sẽ viết thêm phần nhận xét bằng lời.
# Không có key thì toàn bộ phân tích vẫn chạy bằng thống kê thật trên dữ liệu.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --------------------------------------------------------------- Payment ----
# mock  = ghi nhận giao dịch nội bộ, tự động xác nhận (dùng để demo/dev)
# manual = tạo mã chuyển khoản, admin xác nhận tay
PAYMENT_PROVIDER=mock
PAYMENT_BANK_ACCOUNT=

# ------------------------------------------------------------------ Admin ---
# Tài khoản admin đầu tiên được tạo tự động khi khởi động nếu chưa tồn tại.
ADMIN_EMAIL=admin@vigomatch.vn
ADMIN_PASSWORD=

# ---------------------------------------------------------------- OAuth ----
# Đăng nhập bằng Google / Apple. Token do client gửi lên được xác thực bằng
# khoá công khai của nhà cung cấp, và BẮT BUỘC phải khớp client id dưới đây —
# thiếu bước này thì token của bất kỳ ứng dụng nào khác cũng đăng nhập được.
#
# Mỗi nền tảng thường một id; khai nhiều id cách nhau bởi dấu phẩy.
GOOGLE_CLIENT_ID=
# Apple: Service ID (web) và/hoặc Bundle ID (app).
APPLE_CLIENT_ID=

# ------------------------------------------------------------- Thanh toán ---
# Địa chỉ công khai của máy chủ — dùng để dựng returnUrl và ipnUrl cho cổng
# thanh toán. Phải là địa chỉ cổng thanh toán gọi tới được từ Internet.
PUBLIC_URL=http://localhost:3000

# --- VNPay ---
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Sandbox (mặc định) hoặc https://pay.vnpay.vn/vpcpay.html khi chạy thật.
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Bản 2.1.0 mã hoá giá trị trong chuỗi ký. Nếu VNPay báo sai chữ ký, thử đặt 0.
VNPAY_HASH_ENCODE=1

# --- MoMo ---
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
# Sandbox (mặc định) hoặc https://payment.momo.vn khi chạy thật.
MOMO_ENDPOINT=https://test-payment.momo.vn
MOMO_REQUEST_TYPE=captureWallet
